<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MemoDashboard.Backend</RootNamespace>
    <AssemblyName>MemoDashboard.Backend</AssemblyName>
    <!-- Dashboard serves Arabic/English only: skip all other satellite resource languages from publish output. -->
    <SatelliteResourceLanguages>ar;en</SatelliteResourceLanguages>
    <FrontendProjectDir>$(MSBuildProjectDirectory)\..\Frontend</FrontendProjectDir>
    <Version>$(ProductVersion)</Version>
    <AssemblyVersion>$(ProductAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProductAssemblyVersion)</FileVersion>
    <InformationalVersion>$(ProductVersion)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.29" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- 1.2.0: الخط موحّد Simplified Arabic نظاميًا (لا يُوزّع لترخيصه).
         PDF يضمّنه وقت التشغيل إن وجده على المضيف، وإلا fallback نظامي.
         Qomra أُوقف نشرها؛ تُقبل وقت التشغيل كاحتياط قديم فقط. -->
    <Content Include="..\..\..\img\Syrian_logo_icon_gold.svg" Link="ReportAssets\Syrian_logo_icon_gold.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\Fonts\itfQomraArabic-*.*" Link="Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\database\*.sql" Link="database\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RestoreFrontendDependencies" BeforeTargets="BuildFrontend" Condition="!Exists('$(FrontendProjectDir)\node_modules\.package-lock.json') and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm.cmd ci --no-audit --no-fund" WorkingDirectory="$(FrontendProjectDir)" />
  </Target>
  <Target Name="BuildFrontend" BeforeTargets="Build;Publish">
    <Exec Command="npm.cmd --version" WorkingDirectory="$(FrontendProjectDir)" />
    <Exec Command="npm.cmd run build" WorkingDirectory="$(FrontendProjectDir)" />
  </Target>  <ItemGroup>
    <ProjectReference Include="..\..\MemoUpdateContracts\MemoUpdateContracts.csproj" />
    <ProjectReference Include="..\..\AuditMemoSystem.Core\AuditMemoSystem.Core.csproj" />
    <ProjectReference Include="..\..\AuditMemoSystem.Data\AuditMemoSystem.Data.csproj" />
  </ItemGroup>
</Project>
